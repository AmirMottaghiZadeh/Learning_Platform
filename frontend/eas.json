{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pharmenta.ir/api/v1",
        "ANDROID_COMPRESS_NATIVE_LIBS": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pharmenta.ir/api/v1",
        "ANDROID_ARCHS": "arm64-v8a,armeabi-v7a",
        "ANDROID_COMPRESS_NATIVE_LIBS": "1"
      }
    },
    "production-arm64": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pharmenta.ir/api/v1",
        "ANDROID_ARCHS": "arm64-v8a",
        "ANDROID_COMPRESS_NATIVE_LIBS": "1"
      }
    },
    "play": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pharmenta.ir/api/v1",
        "ANDROID_ARCHS": "arm64-v8a,armeabi-v7a"
      }
    }
  }
}
