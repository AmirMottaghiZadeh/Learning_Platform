SECRET_KEY=change-me
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ENVIRONMENT=local
APP_VERSION=0.1.0
RELEASE_SHA=local
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# `docker compose up db` publishes Postgres on host port 5433:
#   DATABASE_URL=postgresql://pharmexa:pharmexa_local_password@127.0.0.1:5433/pharmexa
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pharmexa
LOG_LEVEL=INFO
LOG_FORMAT=plain
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_STEP_UP_TTL_MINUTES=10
PASSWORD_RESET_TIMEOUT=86400
PASSWORD_RESET_FRONTEND_URL=http://localhost:8081
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@pharmexa.local
# Redis powers the shared cache, the distributed throttle counters and the
# Celery broker. Leave empty for a local run without Redis; production requires it.
REDIS_URL=
CACHE_URL=
THROTTLE_CACHE_URL=
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=pharmexa-default-cache
CACHE_KEY_PREFIX=pharmexa:local
CACHE_VERSION=1
CACHE_DEFAULT_TIMEOUT=300
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=500
READINESS_REQUIRE_CACHE=False
READINESS_REQUIRE_BROKER=False
ASYNC_EMAIL_ENABLED=True
THROTTLE_FAIL_CLOSED_SCOPES=auth_login,auth_register,auth_password_reset_request,auth_password_reset_confirm
DRF_ANON_THROTTLE_RATE=1000/hour
DRF_AUTH_LOGIN_THROTTLE_RATE=5/min
DRF_AUTH_REGISTER_THROTTLE_RATE=5/hour
DRF_AUTH_PASSWORD_RESET_REQUEST_THROTTLE_RATE=3/hour
DRF_AUTH_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=5/hour
DATA_QUALITY_MIN_REASON_LENGTH=12
DATA_QUALITY_REQUIRE_BACKUP=True
DATA_QUALITY_BACKUP_DIR=
DATA_QUALITY_STEP_UP_TTL_MINUTES=10
DATA_QUALITY_AUDIT_VERIFY_LIMIT=500
QUIZ_API_ENABLED=True
FLASHCARDS_API_ENABLED=True
DATA_QUALITY_CENTER_ENABLED=False
